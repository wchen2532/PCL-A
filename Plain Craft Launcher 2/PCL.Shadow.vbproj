<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PCL 影子构建工程（Shadow Build Project）

    用 SDK 风格的 VB/WPF 工程编译本目录下的 upstream 源码，
    与原 "Plain Craft Launcher 2.vbproj"（VS + .NET Framework 4.8 开发包）并存，互不覆盖。
    目的：在只装了 dotnet SDK + .NET Framework 4.8 运行时的机器上产出可运行的 exe。

    构建（两个前置 C# 工程需要 C# 12，因为本机 SDK 8 不支持 LangVersion 13）：
        dotnet build "PCL.Shadow.vbproj" -c Debug
    （AdditionalProperties="LangVersion=12.0" 会传递给三个被引用工程）
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>Plain Craft Launcher 2</AssemblyName>
    <MyType>Custom</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
    <WarningLevel>1</WarningLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Images\icon.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">SNAPSHOT</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">RELEASE</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Snapshot'">SNAPSHOT</DefineConstants>
    <_MyType>Custom</_MyType>
  </PropertyGroup>

  <!-- .NET Framework 4.8 参考程序集：免装 Developer Pack / Visual Studio -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- ============ 源码 ============ -->
  <ItemGroup>
    <!-- Controls\MySliderDot.xaml.vb 在原 vbproj 中本就不参与编译（引用了不存在的成员），此处保持一致 -->
    <Compile Include="**\*.vb" Exclude="bin\**;obj\**;Controls\MySliderDot.xaml.vb" />
    <ApplicationDefinition Include="Application.xaml" />
    <Page Include="**\*.xaml" Exclude="Application.xaml;Resources\Custom.xaml;bin\**;obj\**" />
    <Resource Include="Images\**\*" />
    <Resource Include="Resources\Font.ttf" />
    <EmbeddedResource Include="My Project\Resources.resx">
      <LogicalName>PCL.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ============ 需要拷贝到输出目录的运行时资源 ============ -->
  <ItemGroup>
    <None Include="App.config" />
    <None Include="Resources\Custom.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Help.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\forge-installer.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\transformer.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PCLCS\Launch\JavaWrapper.jar" Link="Resources\java-wrapper.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PCLCS\Launch\LwjglUnsafeAgent.jar" Link="Resources\lwjgl-unsafe-agent.jar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\libwebp64.dll" Link="Resources\libwebp64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\NAudio.dll" Link="NAudio.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Imazen.WebP.dll" Link="Imazen.WebP.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Ookii.Dialogs.Wpf.dll" Link="Ookii.Dialogs.Wpf.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\CacheCow.Client.dll" Link="CacheCow.Client.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\CacheCow.Client.FileStore.dll" Link="CacheCow.Client.FileStore.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\CacheCow.Common.dll" Link="CacheCow.Common.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\ThrottleDebounce.dll" Link="ThrottleDebounce.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\System.Net.Http.Formatting.dll" Link="System.Net.Http.Formatting.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Newtonsoft.Json.dll" Link="Newtonsoft.Json.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ============ 程序集引用 ============ -->
  <ItemGroup>
    <Reference Include="CacheCow.Client"><HintPath>Resources\CacheCow.Client.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CacheCow.Client.FileStore"><HintPath>Resources\CacheCow.Client.FileStore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CacheCow.Common"><HintPath>Resources\CacheCow.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ThrottleDebounce"><HintPath>Resources\ThrottleDebounce.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Imazen.WebP"><HintPath>Resources\Imazen.WebP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NAudio"><HintPath>Resources\NAudio.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>Resources\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ookii.Dialogs.Wpf"><HintPath>Resources\Ookii.Dialogs.Wpf.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http.Formatting"><HintPath>Resources\System.Net.Http.Formatting.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Runtime.Caching" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <!-- ============ 三个 upstream 子工程（C# 侧需要 C# 12） ============ -->
  <ItemGroup>
    <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" AdditionalProperties="LangVersion=12.0" />
    <ProjectReference Include="..\MeloongCore\Wpf\MeloongCore.Wpf.csproj" AdditionalProperties="LangVersion=12.0" />
    <ProjectReference Include="..\PCLCS\PCLCS.csproj" AdditionalProperties="LangVersion=12.0" />
  </ItemGroup>

  <!-- ============ 隐式 Imports（等价原 vbproj 的 <Import Include="...">） ============ -->
  <ItemGroup>
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="Newtonsoft.Json" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="PCLCS" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
    <Import Include="ThrottleDebounce" />
  </ItemGroup>

</Project>
